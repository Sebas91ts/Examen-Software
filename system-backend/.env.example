# Backend production template
# Copy to .env in your deployment environment and fill real values there.

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=test

JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRATION=86400000
JWT_PREFIX=Bearer

CAMUNDA_BASE_URL=http://localhost:8081/engine-rest
CAMUNDA_ADMIN_PASSWORD=change-me

FASTAPI_BASE_URL=http://localhost:8000
FASTAPI_URL=http://localhost:8000

FIREBASE_ENABLED=true
FIREBASE_SERVICE_ACCOUNT_BASE64=replace-with-base64-service-account-json
FIREBASE_PROJECT_ID=replace-with-firebase-project-id

AI_ANALYSIS_ENABLED=true
AI_ANALYSIS_SCHEDULE_MS=21600000
AI_ANALYSIS_MIN_SCORE_NOTIFY=70
AI_ANALYSIS_NOTIFY_SEVERITY=high

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
